# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Python
__pycache__/
*.pyc
.venv/
venv/
.venv-tts/

# Node (HyperFrames, Puppeteer)
node_modules/
motion-lib/.harness/
.harness/
motion-lib/renders/
golden/*/project/renders/
out/
dist/
.hyperframes/
.env
.env.*

# Runner state (BUILD_SPEC.md section 1), anchored to the root: pipeline/tests/fixtures/runs/ holds frozen test data
/runs/
/exports/
/logs/
/.locks/
library/voice/*
!library/voice/README.txt
library/.hooks.index.json
library/hooks.lint.txt

# Reference videos, analysis frames, sound pack audio and caches
styles/*/refs/
styles/*/analysis/
styles/sfx/**/*.wav
styles/sfx/**/*.mp3
styles/sfx/**/*.MP3
styles/sfx/**/*.aif
styles/sfx/**/*.aiff
styles/sfx/**/*.ogg
styles/sfx/**/*.flac
styles/sfx/**/*.m4a
styles/sfx/.cache/
styles/sfx/previews/

# Large media: raw footage and renders
*.mp4
*.mov
*.m4a
*.wav

# Build runner runtime files
build/state.env
build/.status
build/status.txt
build/*.log
build/limits.log
build/*/batches/
build/check.*
build/PAUSE
voicetests/

# The golden reel: the render and the per-run reports are rebuilt by render-golden; the project's fonts and vendor
# files are copies of motion-lib/assets
golden/*/golden.mp4
golden/*/render.json
golden/*/probe.json
golden/*/check.json
golden/*/project/assets/fonts/
golden/*/project/assets/vendor/
golden/*/project/assets/vo.wav
golden/*/project/.hyperframes/
golden/*/project/renders/
golden/*/.sheet/
motion-lib/.hyperframes/
