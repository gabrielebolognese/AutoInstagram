    "denied": [
      "Bash(gh auth *)",
      "Bash(gh gist *)",
      "Bash(gh repo clone *)",
      "Bash(gh release download *)",
      "Bash(gh * create *)",
      "Bash(gh * delete *)",
      "Bash(gh * edit *)",
      "Bash(gh * comment *)",
