  "preflight": {
    "require": [
      {
        "check": "command",
        "name": "claude",
        "fix": "npm install -g @anthropic-ai/claude-code, then run claude once and log in"
      },
      {
        "check": "command",
        "name": "ffmpeg",
        "fix": "winget install Gyan.FFmpeg, then open a new terminal"
      },
      {
        "check": "command",
        "name": "ffprobe",
        "fix": "ffprobe ships with ffmpeg: winget install Gyan.FFmpeg, then open a new terminal"
      },
      {
        "check": "command",
        "name": "python",
        "min_version": "3.11",
        "fix": "install Python 3.13 from python.org with 'Add to PATH'; 'python' must resolve to it (python3 is the Windows Store stub)"
      },
      {
        "check": "command",
        "name": "node",
        "min_version": "22.0",
        "fix": "install Node 22 LTS from nodejs.org"
      },
      {
        "check": "command",
        "name": "gh",
        "fix": "winget install GitHub.cli, then gh auth login"
      },
      {
        "check": "command",
        "name": "git",
        "fix": "install Git for Windows from git-scm.com"
      },
      {
        "check": "python_module",
        "name": "jsonschema",
        "fix": "bash pipeline/bin/setup-python"
      },
      {
        "check": "python_module",
        "name": "playwright",
        "level": "warn",
        "fix": "bash pipeline/bin/setup-python (installs playwright and its Chromium; without it the research stage takes no screenshots)"
      },
      {
        "check": "voice",
        "fix": "write library/voice/engine.txt as in BUILD_SPEC.md 2.5 (engine = kokoro, python = <a Python 3.11 venv that imports kokoro>, voice = af_bella, lang = a, speed = 1.0, silence_threshold_db = -40, min_pause_s = 0.3, keep_pause_s = 0.1, breath_after_hook_s = 1.0); its interpreter must import kokoro (bash pipeline/bin/setup-venv --kokoro installs one at config paths.kokoro_python) and one interpreter must import faster_whisper (config tts.whisper_python, or bash pipeline/bin/setup-venv for .venv-tts)"
      },
      {
        "check": "file",
        "path": "styles/sfx/sfx-map.json",
        "level": "warn",
        "fix": "bash pipeline/bin/build-sfx-map (measures styles/sfx/ and writes the sound effects map; without it the sound stage renders the voice alone and flags the reel NEEDS REVIEW)"
      },
      {
        "check": "file",
        "path": "styles/paper-cards/style.md",
        "fix": "restore it: git checkout -- styles/paper-cards/style.md"
      },
      {
        "check": "file",
        "path": "styles/paper-cards/tweaks.md",
        "fix": "restore it: git checkout -- styles/paper-cards/tweaks.md"
      },
      {
        "check": "file",
        "path": "styles/paper-cards/vocabulary.md",
        "fix": "restore it: git checkout -- styles/paper-cards/vocabulary.md"
      },
      {
        "check": "file",
        "path": "styles/paper-cards/tokens.json",
        "fix": "bash pipeline/bin/build-tokens (derives tokens.json from style.md plus tweaks.md; the visual stages read it)"
      },
      {
        "check": "file",
        "path": "motion-lib/catalog.json",
        "fix": "restore the motion library: git checkout -- motion-lib, then python pipeline/lib/motion catalog --write"
      },
      {
        "check": "file",
        "path": "node_modules/hyperframes/package.json",
        "fix": "bash pipeline/bin/setup-node (installs the pinned hyperframes, gsap and three packages and the render browser)"
      },
      {
        "check": "brand",
        "fix": "restore the FlashFX brand kit: git checkout -- library/brand (brand.json and every logo file it lists; BUILD_SPEC.md 2.7)"
      },
      {
        "check": "file",
        "path": "library/hooks.txt",
        "in_root": true,
        "fix": "restore it: git checkout -- library/hooks.txt (one hook per line, __ marks the blank)"
      },
      {
        "check": "disk",
        "min_free_gb": 10,
        "fix": "free at least 10 GB on the drive that holds the repo (renders live in runs/ and exports/)"
      },
      {
        "check": "shell",
        "cmd": "gh auth status",
        "level": "warn",
        "fix": "gh auth login (the research stage needs it from M4 on)"
      }
    ]
  },
  "render": {
    "draft_resolution": "540x960",
    "final_resolution": "1080x1920",
    "fps": 30,
    "quality": "looks",
    "audio_bitrate_k": 160,
    "audio_channels": 1,
    "duration_tolerance_s": 0.2,
    "loudness_tolerance_lu": 1.0,
    "true_peak_tolerance_db": 0.5,
    "hook2_max_s": 3.5
  },
  "caption": {
    "first_line_max_chars": 125,
    "hashtags": [
      3,
      5
    ],
    "body_chars": [
      150,
      900
    ],
    "tries": 2
  },
  "logs": {
    "rotate_mb": 50,
    "rotate_keep": 3
  }
}
