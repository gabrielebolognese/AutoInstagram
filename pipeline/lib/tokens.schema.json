{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instagramreels.local/styles/tokens.json",
  "title": "styles/<style>/tokens.json: the look as data, derived from style.md plus tweaks.md by pipeline/lib/tokens.py (BUILD_SPEC.md 2.4)",
  "type": "object",
  "required": ["style", "style_version", "tokens_version", "generated", "sources", "in_force", "canvas", "colors", "fonts", "type",
               "zones", "shapes", "motion", "transitions", "pacing", "limits", "branding", "energy", "tracker", "honesty_labels", "beat_map",
               "open_questions"],
  "properties": {
    "style": {"type": "string"},
    "style_version": {"type": "integer"},
    "tokens_version": {"type": "integer"},
    "generated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "sources": {"type": "object", "required": ["style.md", "tweaks.md"],
                "properties": {"style.md": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tweaks.md": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "in_force": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "canvas": {"type": "object", "required": ["width", "height", "fps"],
               "properties": {"width": {"const": 1080}, "height": {"const": 1920}, "fps": {"const": 30}}},
    "colors": {"type": "object",
               "required": ["paper", "glow-warm", "dot", "surface", "surface-chrome", "ink", "ink-chip", "accent", "accent-deep", "script",
                            "success", "mascot", "media-frame", "unit-serif", "emphasis-text", "keyword-pill", "card-edge", "shadow-dark",
                            "glow-lower", "corner"],
               "additionalProperties": {"type": "string", "pattern": "^#[0-9A-F]{6}$"}},
    "fonts": {"type": "object", "required": ["grotesk", "serif-italic", "kicker", "mono", "handwritten"],
              "additionalProperties": {"type": "object", "required": ["family", "file", "license", "weight", "style", "cap_ratio"],
                                       "properties": {"family": {"type": "string"}, "file": {"type": "string"}, "license": {"type": "string"},
                                                      "weight": {"type": "integer"}, "style": {"enum": ["normal", "italic"]},
                                                      "cap_ratio": {"type": "number", "minimum": 0.5, "maximum": 0.9}}}},
    "type": {"type": "object", "required": ["caption", "headline", "headline_phrase", "kicker", "stat", "end_verb", "end_keyword", "handwritten", "mono"],
             "properties": {
               "caption": {"type": "object", "required": ["cap_px", "font_px", "font", "case"]},
               "headline": {"type": "object", "required": ["cap_px", "font_px", "line_px", "font"]},
               "kicker": {"type": "object", "required": ["cap_px", "font", "case", "color"]},
               "stat": {"type": "object", "required": ["digit_px", "font_px", "font"]},
               "end_verb": {"type": "object", "required": ["cap_px", "font_px", "font"]},
               "end_keyword": {"type": "object", "required": ["cap_px", "font_px", "font"]},
               "handwritten": {"type": "object", "required": ["line_px", "font_px", "font", "color"]}}},
    "zones": {"type": "object", "required": ["safe_top", "safe_bottom", "margin_x", "kicker_top", "hero", "caption", "right_rail", "end_card"],
              "properties": {
                "safe_top": {"type": "number"}, "safe_bottom": {"type": "number"}, "margin_x": {"type": "number"}, "kicker_top": {"type": "number"},
                "hero": {"type": "object", "required": ["top_min", "top_max", "bottom_max"]},
                "caption": {"type": "object", "required": ["center_y", "max_width", "x0", "x1", "safe_zone_exception"],
                            "properties": {"center_y": {"type": "number"}, "max_width": {"type": "number"}, "x0": {"type": "number"},
                                           "x1": {"type": "number"}, "safe_zone_exception": {"type": "boolean"}}},
                "right_rail": {"type": "object", "required": ["width", "from_y"]},
                "end_card": {"type": "object", "required": ["width", "height", "x", "top", "tilt_deg", "mascot_row_y", "mascot_gap", "mascots"]}}},
    "shapes": {"type": "object", "required": ["card", "media_frame_px", "stat_pill_h", "stat_chip_h", "dark_chip_h", "light_chip_h", "emphasis_box", "mascot", "dots", "glow"],
               "properties": {
                 "card": {"type": "object", "required": ["radius", "edge_px", "shadow"],
                          "properties": {"shadow": {"type": "object", "required": ["above", "side", "below", "below_median", "css_offset_y", "css_blur"]}}},
                 "emphasis_box": {"type": "object", "required": ["height", "radius", "above_cap", "below_baseline", "gap"]},
                 "dots": {"type": "object", "required": ["size_px", "spacing_px"]}}},
    "motion": {"type": "object", "required": ["enter", "exit", "pop", "count_up", "caption", "end_card", "typing_frames_per_letter", "mascot", "hook", "headline", "grammar"],
               "properties": {
                 "grammar": {"type": "object", "required": ["main", "inertia", "hold", "exit", "edges", "ambient", "camera", "captions", "text_zones", "static_max_s"],
                             "properties": {"hold": {"type": "object", "required": ["calm", "normal", "lively", "default"]},
                                            "text_zones": {"type": "object", "required": ["caption", "hook", "endcard"]}}},
                 "enter": {"type": "object", "required": ["opacity_frames", "position_frames", "rise_px", "ease"]},
                 "pop": {"type": "object", "required": ["from_scale", "frames", "overshoot_icon_pct", "overshoot_pill_pct"]},
                 "count_up": {"type": "object", "required": ["frames", "ease"]},
                 "caption": {"type": "object", "required": ["word_frames", "box_frames", "box_rise_px", "replace_out_frames"]},
                 "end_card": {"type": "object", "required": ["fade_frames", "stagger_frames", "hold_s", "keyword"]},
                 "headline": {"type": "object", "required": ["mode", "word_frames"]}}},
    "transitions": {"type": "object", "required": ["scene_change", "default", "allowed", "fade_blur_frames", "fall_frames", "push_out_frames", "push_gap_frames", "push_in_frames"],
                    "properties": {"allowed": {"type": "array", "items": {"type": "string"}, "minItems": 1}}},
    "pacing": {"type": "object", "required": ["changes_per_10s_median", "gap_median_s", "gap_p90_s", "gap_max_s", "scene_s", "first_change_max_frames"]},
    "limits": {"type": "object", "required": ["accent_share_max_pct", "length_s", "three_d", "caption", "set_pieces_per_reel"],
               "properties": {"length_s": {"type": "object", "required": ["default", "list"]},
                              "three_d": {"type": "object", "required": ["scenes", "max_objects"]}}},
    "branding": {"type": "object", "required": ["lockup_min_width", "bolt_min_height", "cta"]},
    "energy": {"type": "object", "required": ["targets", "directions", "calibration", "meter"],
               "properties": {"targets": {"type": "object", "required": ["moving_share_pct", "middle_moving_share_pct", "pixels_changing_pct", "still_share_pct", "longest_still_s"],
                                          "additionalProperties": {"type": "number"}}}},
    "tracker": {"type": "object", "required": ["enabled"], "properties": {"enabled": {"const": false}}},
    "honesty_labels": {"type": "object", "required": ["enabled", "look", "texts"]},
    "beat_map": {"type": "object", "required": ["hook", "stake", "number", "tool", "step", "comparison", "proof", "mechanism", "before-after", "pain-payoff", "payoff", "ask", "any"],
                 "additionalProperties": {"type": "array", "items": {"type": "string"}, "minItems": 1}},
    "style_beat_map": {"type": "array"},
    "open_questions": {"type": "object", "minProperties": 15, "additionalProperties": {"type": "string"}}
  }
}
